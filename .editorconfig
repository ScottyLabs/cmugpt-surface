# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
# Spaces keep indentation consistent wherever the code is viewed, including git.cmu.dev
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.sql]
# Drizzle Kit migrations use tab indentation by default.
indent_style = tab

[*.md]
# Disable indentation for Markdown files, since for an unordered list nested
# inside an ordered list, the indentation is determined by the list marker
# alignment, which might not be a multiple of the indent size.
indent_size = unset
